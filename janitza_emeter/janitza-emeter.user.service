[Unit]
Description=Janitza UMG 604-PRO to SMA Energy Meter bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pysmaemeter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/pysmaemeter/janitza_emeter/janitza_emeter.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
