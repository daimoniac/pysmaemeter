[Unit]
Description=Janitza UMG 604-PRO to SMA Energy Meter bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/home/administrator/pysmaemeter
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/administrator/pysmaemeter/janitza_emeter/janitza_emeter.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
